# Copia questo file in .env.local e compila i valori confermati dal titolare.
# Nessuno di questi valori va lasciato inventato: se un dato non è confermato,
# la variabile resta vuota e il sito la ignora (vedi docs/informazioni-da-confermare.md).

# Indirizzo pubblico del sito (senza slash finale). Usato per metadati assoluti,
# sitemap.xml, robots.txt e anteprime social.
NEXT_PUBLIC_SITE_URL=https://esempio.it

# Recapiti ufficiali, da pubblicare solo dopo conferma esplicita del titolare.
# Finché sono vuoti, la pagina /contatti mostra lo stato "in fase di pubblicazione".
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LINKEDIN=
